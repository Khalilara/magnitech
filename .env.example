# ---------- Domaine & TLS ----------
DOMAIN=maghitech.fr
ACME_EMAIL=ops@maghitech.fr
# IP/CIDR autorisées sur admin.<domaine> (bureau, VPN)
ADMIN_IP_ALLOWLIST=203.0.113.10/32,10.8.0.0/24
ADMIN_EMAIL=
AUTH_COOKIE_DOMAIN=.maghitech.fr
SESSION_TTL_DAYS=7

# OAuth credentials (register callback URLs at https://api.${DOMAIN}/v1/auth/{provider}/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ---------- Images ----------
REGISTRY=ghcr.io/maghitech
TAG=latest
API_REPLICAS=2
STOREFRONT_REPLICAS=2

# ---------- PostgreSQL ----------
POSTGRES_USER=maghitech
POSTGRES_PASSWORD=change-me-openssl-rand-hex-32
POSTGRES_DB=maghitech

# ---------- Redis / Meilisearch ----------
REDIS_PASSWORD=change-me
MEILI_MASTER_KEY=change-me-min-16-bytes

# ---------- Stockage objets S3 (Scaleway / OVHcloud) ----------
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_REGION=fr-par
S3_BUCKET=maghitech-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=https://media.maghitech.fr

# ---------- Sécurité ----------
JWT_SECRET=change-me-openssl-rand-hex-64
REVALIDATE_SECRET=change-me

# ---------- Stripe (Connect) ----------
STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---------- Transporteurs (provider:secret,…) ----------
CARRIER_WEBHOOK_SECRETS=sendcloud:xxx,boxtal:yyy

# ---------- Règles métier ----------
DEFAULT_COMMISSION_BPS=1200      # 12 %
RETURN_WINDOW_DAYS=14            # délai de rétractation avant reversement

SENTRY_DSN=
