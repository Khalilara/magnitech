{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "magnitech",
	"compatibility_date": "2026-11-18",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "MAGHITECH_DB",
			"database_name": "maghitech-db",
			"database_id": "e6fcdc83-39cc-4075-934d-ae72ca12ed76"
		}
	],
	"r2_buckets": [
		{
			"binding": "MAGNITECH_PRODUCT_IMAGES",
			"bucket_name": "magnitech-product-images"
		}
	],
	"previews": {
		"d1_databases": [
			{
				"binding": "MAGHITECH_DB",
				"database_name": "maghitech-db",
				"database_id": "e6fcdc83-39cc-4075-934d-ae72ca12ed76"
			}
		],
		"r2_buckets": [
			{
				"binding": "MAGNITECH_PRODUCT_IMAGES",
				"bucket_name": "magnitech-product-images"
			}
		]
	}
}
